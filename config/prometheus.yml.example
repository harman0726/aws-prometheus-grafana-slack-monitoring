
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - "alert_rules.yml"

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  # Example only: replace with your actual
  # EC2 service-discovery configuration.
  - job_name: "node_exporter"
    static_configs:
      - targets: ["YOUR_PRIVATE_EC2_IP:9100"]
